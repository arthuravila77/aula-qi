double areaRetangulo(double b, double a) {
  return b * a;
}

double areaTrapezio(
  double bMenor,
  double bMaior, 
  double a
) {
  return((bMaior + bMenor) * a) / 2;
}





import 'dart:math';

double calcularDelta(double a, double b, double c) {
  return b * b - 4 * a * c;
}

void calcularRaizes(double a, double b, double delta) {
  if (delta >= 0) {
    double x1 = (-b + sqrt(delta)) / (2 * a);
    double x2 = (-b - sqrt(delta)) / (2 * a);
    print("Raiz x1: $x1");
    print("Raiz x2: $x2");
  } else {
    print("Não existem raízes reais.");
  }
}

void main() {
  double a = 1;
  double b = -3;
  double c = 2;

  double delta = calcularDelta(a, b, c);
  print("Delta: $delta");

  calcularRaizes(a, b, delta);
}
